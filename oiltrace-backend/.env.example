# Optional absolute path to the Git LFS-downloaded Stage 1 checkpoint.
# Leave unset to use ml/detection/checkpoints/sar_unet_best.pt.
OILTRACE_SAR_MODEL_PATH=

# Replace this development default before deployment.
OILTRACE_SECRET_KEY=

# Optional verified historical AIS CSV. If unset, attribution explicitly
# returns no vessel data and never substitutes synthetic ships.
OILTRACE_AIS_DATA_PATH=
