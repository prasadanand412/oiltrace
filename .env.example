# Copy this file to .env and fill in your own key. The real .env is
# gitignored and must never be committed.

# OpenWeatherMap API key - used by ml/drift_trace/model.py (get_current_wind)
# to fetch real wind for the backward drift trace. Free tier is sufficient.
# Get one at https://openweathermap.org/api
OPENWEATHER_API_KEY=
